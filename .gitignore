.expo/
dist/
web-build/
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store

# export web do Expo
dist/

# build da extensao do Chrome (o ZIP e distribuido pelos releases do GitHub)
dist-extension/
promo-radar-extensao*.zip

# APK gerado
dist-apk/

# build do app web (Next)
web/.next/
web/out/
web/next-env.d.ts
web/tsconfig.tsbuildinfo
.vercel/

# projeto nativo, recriado por `npx expo prebuild`
android/
ios/

# segredos: o .env vale em qualquer nivel (raiz, web/), e o .env.example e o
# unico que sobe, porque so tem os nomes das chaves e nenhum valor
.env
.env.*
!.env.example

# chave de assinatura do APK: perde-la impede atualizar o app ja instalado
*.jks
*.keystore
# formato antigo das credenciais de assinatura, hoje no .env
keystore.properties
